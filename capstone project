pipeline {
  agent any 

  environment {
      SCANNER_HOME = tool 'sonar-scanner'
      IMAGE_TAG = "v${BUILD_NUMBER}"
  stages {
    stage('Git Checkout') {
      steps {
          echo 'Hello World'
      }
   }

  stages {
    stage('Gitleak scan') {
      steps {
         sh 'gitleak detect --report fromat-json --report path gitleaks  report.json --exit code=1'
      }
   }

  stages {
    stage('compile') {
      steps {
          sh 'dotnet build'
      }
   }

  stages {
    stage('Trivy FS Scan') {
      steps {
         sh 'trivy fs --format table -o trivy-fs-report.html .'
      }
   }

  stages {
    stage('Unit Testing') {
      steps {
          echo 'dotnet test'
      }
   }

  stages {
    stage('SonarQube Analysis') {
      steps {
          withSonarQubeEnv('sonar') {
              sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=NoteApp \
                       -Dsonar.projectkey=NoteApp '''
          }
      }
   }

  stages {
    stage('Quality Gate Check') {
      steps {
          timeout(time: 1,unit: 'HOURS') {
              waitforQualityGate abortPipeline: false, credenteials: 'sonar-token'

          }
      }
   }

  stages {
    stage('Building the Docker Image & Tag Image') {
      steps {
          script {
              withDockerRegistry(credentaialsId: 'docker-cred') {
                  sh "docker build -t harshad/notepad:$IMAGE_TAG ."
            }
          }
      }
   }

  stages {
    stage('trivy Image Scan') {
      steps {
          sh 'trivy image --format table -o trivy-image-report.html harshad/notepad:$IMAGE_TAG'
      }
   }

  stages {
    stage('Push Image') {
      steps {
          script {
              withDockerRegistry(credentaialsId: 'docker-cred') {
                  sh "docker push harshad/notepad:$IMAGE_TAG"
            }
          }
      }
   }

  stages {
    stage('Update Manifest File CD Repo') {
      steps {
          script {
              cleanws()
              withCredentials([usernamePassword(credentialsId: 'git-token', passwordVariable: 'GIT_PASSWORD', usernameVairable: 'GIT_USERNAME')])
                  sh '''
                       # clone the CD Repo
                       git clone https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/harshadbhargude/CapStone-DotNET-Mongo-CD.git
                       # update the tag in manifest
                       cd CapStone-DotNET-Mongo-CD
                       sed -i "s|harshadbhargude/noteapp:.*|harshadbhargude/noteapp:${IMAGE_TAG}|" Manifest/mainfest.yaml

                       #confirm changes
                       echo "update manifest file contents:"
                       cat Manifest/manifest.yaml

                      # commit and push the changes
                      git config user.name "jenkins"
                      git config user.email "jenkins@example.com"
                      git add Manifest/manifest.yaml
                      git commit -m "update image tag to ${IAMGE_TAG}"
                      git push origin main
                      '''
                   }
          }
      }
   }

  stages {
    stage('Hello World') {
      steps {
          echo 'Hello World'
      }
   }


